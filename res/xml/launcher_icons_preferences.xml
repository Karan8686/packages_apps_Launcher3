<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.launcher3">

    <Preference
        android:key="pref_icon_pack"
        android:title="@string/icon_pack_title" />

    <com.android.launcher3.settings.NotificationDotsPreference
        android:key="pref_icon_badging"
        android:title="@string/notification_dots_title"
        android:persistent="false"
        android:widgetLayout="@layout/notification_pref_warning" />

    <SwitchPreferenceCompat
        android:key="pref_notification_badge_count"
        android:title="@string/notification_badge_count_title"
        android:summary="@string/notification_badge_count_desc"
        android:persistent="true"
        android:defaultValue="false" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_custom_icon_size"
        android:title="@string/icon_size_title"
        android:persistent="true"
        android:max="150"
        settings:min="50"
        settings:units="%"
        android:defaultValue="100" />

    <com.android.launcher3.settings.preferences.CustomSeekBarPreference
        android:key="pref_custom_font_size"
        android:title="@string/font_size_title"
        android:persistent="true"
        android:max="150"
        settings:min="50"
        settings:units="%"
        android:defaultValue="100" />

    <PreferenceCategory
        android:key="pref_themed_icons_category"
        android:title="@string/themed_icons_category_title">

        <SwitchPreferenceCompat
            android:key="themed_icons"
            android:title="@string/themed_icons_title"
            android:summary="@string/themed_icons_summary"
            android:defaultValue="false"
            android:persistent="false"
            launcher:iconSpaceReserved="false" />

        <com.android.launcher3.settings.preferences.CustomSeekBarPreference
            android:key="themed_icon_scale"
            android:title="@string/themed_icon_scale_title"
            android:dependency="themed_icons"
            android:persistent="false"
            android:max="100"
            settings:min="48"
            settings:units="%"
            android:defaultValue="100" />

        <ListPreference
            android:key="themed_icon_color_preset"
            android:title="@string/themed_icon_color_preset_title"
            android:summary="%s"
            android:entries="@array/themed_icon_color_preset_entries"
            android:entryValues="@array/themed_icon_color_preset_values"
            android:defaultValue="axicons"
            android:dependency="themed_icons"
            android:persistent="false"
            launcher:iconSpaceReserved="false" />

        <com.android.launcher3.settings.preferences.ColorPreference
            android:key="themed_icon_background_color"
            android:title="@string/themed_icon_background_color_title"
            android:dependency="themed_icons"
            android:persistent="false"
            launcher:iconSpaceReserved="false" />

        <com.android.launcher3.settings.preferences.ColorPreference
            android:key="themed_icon_foreground_color"
            android:title="@string/themed_icon_foreground_color_title"
            android:dependency="themed_icons"
            android:persistent="false"
            launcher:iconSpaceReserved="false" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
